    <EntryPoint type="InGameUIAddin" file="Lua/Gabriel_Core.lua">
      <Name>Gabriel Colony Network</Name>
      <Description>Runs city Node timers, network effects, Nexus scaling, detection, AI placement, and Infestation.</Description>
    </EntryPoint>
    <EntryPoint type="InGameUIAddin" file="UI/Gabriel_NodePlacement.xml">

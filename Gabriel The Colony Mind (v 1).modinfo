<Mod id="7c80858b-1d6b-4a9c-9d6f-f793c10b16e4" version="1">
  <Properties>
    <Name>Gabriel — The Colony Mind</Name>
    <Stability>Alpha</Stability>
    <Teaser>Many minds. One purpose. Preparation makes chance unnecessary.</Teaser>
    <Description>A defensive Science civilization led by Gabriel. Prepare territorial Colony Nodes, weaken invaders with Swarm Hosts, and connect mature cities through Colony Nexuses.</Description>
    <Authors>SolusGo</Authors>
    <SpecialThanks>Community Patch Project</SpecialThanks>
    <HideSetupGame>0</HideSetupGame>
    <Homepage>https://github.com/SolusGo/GabrielTheColonyMind</Homepage>
